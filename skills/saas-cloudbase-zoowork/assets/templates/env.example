# 环境标识由 Codex 核对后写入本地配置；秘密仅通过安全渠道配置。
APP_ID=
CLOUDBASE_ENV_ID=
CLOUDBASE_REGION=
CLOUDBASE_SERVICE_NAME=
CLOUDBASE_HTTP_BASE=
CLOUDBASE_APIKEY=
CLOUDBASE_PUBLISHABLE_KEY=
CLOUDBASE_STORAGE_BUCKET=
# 仅使用自定义登录桥接时设置；未启用时不要求。
CLOUDBASE_CUSTOM_CREDENTIALS=
PORTAL_ENABLED=true
PORTAL_PROVIDER_ID=
PARTNER_API_KEY=
ENTERPRISE_ENCRYPTION_KEY=
SESSION_SECRET=
