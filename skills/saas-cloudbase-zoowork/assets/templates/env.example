PORT=8787
# MODEL=

# 以下仅在明确选用对应服务端 SDK／PG 直连路径时启用，不能全部设为通用必填。
# CLOUDBASE_SECRET_ID=
# CLOUDBASE_SECRET_KEY=
# CLOUDBASE_SESSION_TOKEN=
# DATABASE_URL=
# 员工 Key 由后端开通后加密入库，不在此定义全局执行 Key。
